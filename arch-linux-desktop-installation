#!/bin/bash

# Installation script for Arch Linux desktop environment.

error() {
  printf "%s\n" "Failed to install Arch Linux desktop environment" >&2
  exit 1
}

set -Ee -o pipefail

trap error ERR

sudo --validate

readonly -A COLORS=(
  ["Gray A"]="#282828"
  ["Gray B"]="#464646"
  ["Gray C"]="#6f6f6f"
  ["Pink"]="#f92472"
  ["Green"]="#a6e22c"
  ["Yellow"]="#ffe894"
  ["Blue"]="#67d8ef"
  ["Purple"]="#ac80ff"
  ["Teal"]="#2aa198"
  ["White"]="#f7f7f7"
)

readonly DEFAULT_HEIGHT=7
readonly DEFAULT_WIDTH=74

nvidia_device_detected="false"
selection_install_nvidia_driver="false"
while IFS= read -r device; do
  if ! read -r vendor 2>/dev/null < "${device}/vendor" || ! read -r class 2>/dev/null < "${device}/class"; then
    continue
  fi
  if [[ "${vendor}" == "0x10de" && "${class}" == "0x03"* ]]; then
    nvidia_device_detected="true"
    if whiptail --title "NVIDIA" --yesno "Install NVIDIA driver?" "${DEFAULT_HEIGHT}" "${DEFAULT_WIDTH}" 3>&1 1>&2 2>&3; then
      selection_install_nvidia_driver="true"
    fi
    break
  fi
done < <(find /sys/bus/pci/devices/ -mindepth 1 -maxdepth 1 2> /dev/null)
readonly nvidia_device_detected
readonly selection_install_nvidia_driver

if whiptail --title "Logging" --yesno "Enable logging?" "${DEFAULT_HEIGHT}" "${DEFAULT_WIDTH}" --defaultno 3>&1 1>&2 2>&3; then
  exec &> >(tee --append "${BASH_SOURCE[0]}.log")
fi

set -ux

sudo mkdir --parents /etc/pacman.d/conf/
sudo tee /etc/pacman.d/conf/kde <<- EOF
	NoExtract = usr/share/remoteview/*.desktop
	NoExtract = usr/lib/qt6/plugins/kf6/kfileitemaction/*.so
	NoExtract = usr/lib/qt6/plugins/kf6/purpose/*.so
EOF
sudo tee /etc/pacman.d/conf/noto-fonts <<- EOF
	NoExtract = usr/share/fonts/noto/Noto*.ttf
	NoExtract = !usr/share/fonts/noto/NotoColorEmoji.ttf
	NoExtract = !usr/share/fonts/noto/NotoSans-*.ttf
	NoExtract = !usr/share/fonts/noto/NotoSansMono-*.ttf
	NoExtract = !usr/share/fonts/noto/NotoSansSymbols-*.ttf
	NoExtract = !usr/share/fonts/noto/NotoSerif-*.ttf
EOF

