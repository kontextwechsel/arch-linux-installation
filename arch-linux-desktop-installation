#!/bin/bash

# Installation script for Arch Linux desktop environment.

error() {
  printf "%s\n" "Failed to install Arch Linux desktop environment" >&2
  exit 1
}

set -Ee -o pipefail

trap error ERR

sudo --validate

readonly -A COLORS=(
  ["Gray A"]="#282828"
  ["Gray B"]="#464646"
  ["Gray C"]="#6f6f6f"
  ["Pink"]="#f92472"
  ["Green"]="#a6e22c"
  ["Yellow"]="#ffe894"
  ["Blue"]="#67d8ef"
  ["Purple"]="#ac80ff"
  ["Teal"]="#2aa198"
  ["White"]="#f7f7f7"
)

readonly DEFAULT_HEIGHT=7
readonly DEFAULT_WIDTH=74

nvidia_device_detected="false"
selection_install_nvidia_driver="false"
while IFS= read -r device; do
  if ! read -r vendor 2>/dev/null < "${device}/vendor" || ! read -r class 2>/dev/null < "${device}/class"; then
    continue
  fi
  if [[ "${vendor}" == "0x10de" && "${class}" == "0x03"* ]]; then
    nvidia_device_detected="true"
    if whiptail --title "NVIDIA" --yesno "Install NVIDIA driver?" "${DEFAULT_HEIGHT}" "${DEFAULT_WIDTH}" 3>&1 1>&2 2>&3; then
      selection_install_nvidia_driver="true"
    fi
    break
  fi
done < <(find /sys/bus/pci/devices/ -mindepth 1 -maxdepth 1 2> /dev/null)
readonly nvidia_device_detected
readonly selection_install_nvidia_driver

if whiptail --title "Logging" --yesno "Enable logging?" "${DEFAULT_HEIGHT}" "${DEFAULT_WIDTH}" --defaultno 3>&1 1>&2 2>&3; then
  exec &> >(tee --append "${BASH_SOURCE[0]}.log")
fi

set -ux

sudo mkdir --parents /etc/pacman.d/conf/
sudo tee /etc/pacman.d/conf/noto-fonts <<- EOF
	NoExtract = usr/share/fonts/noto/Noto*.ttf
	NoExtract = !usr/share/fonts/noto/NotoColorEmoji.ttf
	NoExtract = !usr/share/fonts/noto/NotoSans-*.ttf
	NoExtract = !usr/share/fonts/noto/NotoSansMono-*.ttf
	NoExtract = !usr/share/fonts/noto/NotoSansSymbols-*.ttf
	NoExtract = !usr/share/fonts/noto/NotoSerif-*.ttf
EOF

packages=(
  dunst
  flatpak
  grim
  gvfs
  gvfs-mtp
  gvfs-nfs
  gvfs-smb
  libnotify
  pipewire
  pipewire-pulse
  polkit
  slurp
  sway
  swaybg
  swayidle
  waybar
  waylock
  wireplumber
  wl-clipboard
  wmenu
  xcursor-vanilla-dmz
  xdg-desktop-portal # Flatpak dependency
  xdg-desktop-portal-gtk # Flatpak dependency
  xorg-xwayland
)
packages+=(
  alacritty
  firefox
  geany
  gimp
  gpicview
  libreoffice-fresh
  mpv
  pavucontrol
  pcmanfm
  thunderbird
)
packages+=(
  adobe-source-code-pro-fonts
  adobe-source-sans-pro-fonts
  adobe-source-serif-pro-fonts
  noto-fonts
  noto-fonts-emoji
  ttf-liberation
)
packages+=(
  bc
  bind
  curl
  dconf
  dmidecode
  fwupd
  git
  htop
  jq
  lsof
  nmap
  openssl
  p7zip
  pass
  pciutils
  pwgen
  python
  rsync
  smartmontools
  tcpdump
  testdisk
  unrar
  unzip
  usbutils
  wget
  zip
)
readonly packages

sudo pacman --noconfirm --sync --refresh "${packages[@]}"

if [[ "${selection_install_nvidia_driver}" == "true" ]]; then
  sudo pacman --noconfirm --sync nvidia-open

  lines=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ^MODULES= ]]; then
      IFS=" " read -r -a modules <<< "$(sed -r "s/\((.*)\)/\1/g" <<< "${line#*=}")"
      modules+=(
        nvidia
        nvidia_modeset
        nvidia_uvm
        nvidia_drm
      )
      lines+=("MODULES=(${modules[*]})")
    else
      lines+=("${line}")
    fi
  done < /etc/mkinitcpio.conf
  printf "%s\n" "${lines[@]}" | sudo tee /etc/mkinitcpio.conf

  sudo mkinitcpio --preset linux
fi

readonly arc_theme_version="20221218"
arc_theme_directory="$(mktemp -d)"; readonly arc_theme_directory
sudo pacman --noconfirm --sync meson sassc
wget --directory-prefix "${arc_theme_directory}/" "https://github.com/kontextwechsel/arc-theme/releases/download/${arc_theme_version}/arc-theme-${arc_theme_version}.tar.xz"
tar --extract --file "${arc_theme_directory}/arc-theme-${arc_theme_version}.tar.xz" --directory "${arc_theme_directory}/"
meson setup --prefix="${arc_theme_directory}/arc-theme-${arc_theme_version}/install/" -Dthemes=gtk3,gtk4 -Dvariants=lighter -Dtransparency=false "${arc_theme_directory}/arc-theme-${arc_theme_version}/build/" "${arc_theme_directory}/arc-theme-${arc_theme_version}/"
meson install -C "${arc_theme_directory}/arc-theme-${arc_theme_version}/build/"
sudo mkdir --parents /usr/share/themes/Arc/
sudo cp --recursive "${arc_theme_directory}/arc-theme-${arc_theme_version}/install/share/themes/Arc-Lighter-solid/"* /usr/share/themes/Arc/
sudo sed --in-place "s/Arc-Lighter-solid/Arc/g" /usr/share/themes/Arc/index.theme
sudo chmod --recursive u=rwX,go=rX /usr/share/themes/Arc/
sudo pacman --noconfirm --remove --recursive meson sassc
rm --recursive "${arc_theme_directory:?}/"

readonly arc_icon_theme_version="20161122"
arc_icon_theme_directory="$(mktemp -d)"; readonly arc_icon_theme_directory
wget --directory-prefix "${arc_icon_theme_directory}/" "https://github.com/kontextwechsel/arc-icon-theme/archive/refs/tags/${arc_icon_theme_version}.tar.gz"
tar --extract --file "${arc_icon_theme_directory}/${arc_icon_theme_version}.tar.gz" --directory "${arc_icon_theme_directory}/"
sudo cp --recursive "${arc_icon_theme_directory}/arc-icon-theme-${arc_icon_theme_version}/Arc/" /usr/share/icons/
sudo mkdir --parents /usr/share/icons/Arc/symbolic/legacy/
sudo find /usr/share/icons/Arc/ -name applications-system.png -execdir ln --symbolic --force {} gtk-preferences.png \; # GPicView requirement
sudo chmod --recursive u=rwX,go=rX /usr/share/icons/Arc/
rm --recursive "${arc_icon_theme_directory:?}/"

sudo mkdir --parents /usr/local/bin/
sudo tee /usr/local/bin/application-launcher <<- EOF
	#!/bin/bash

	readonly file="\${HOME}/.config/application-launcher/config"

	declare -A applications
	if [[ -f "\${file}" ]]; then
	  while IFS="=" read -r application executable; do
	    applications["\${application}"]="\${executable}"
	  done < "\${file}"
	fi

	print_applications() {
	  case "\$1" in
	    -k | --keys)
	      printf "%s\n" "\${!applications[@]}" | sort
	      ;;
	    *)
	      for application in "\${!applications[@]}"; do
	        printf "%s=%s\n" "\${application}" "\${applications[\${application}]}"
	      done | sort
	      ;;
	  esac
	}

	if [[ "\$#" -gt 0 ]]; then
	  case "\$1" in
	    -a | --add)
	      if [[ ! "\$2" =~ ^[a-z0-9\ ._-]+\$ ]]; then
	        printf "Invalid application\n"
	        exit 1
	      fi
	      if [[ ! -f "\$3" || ! -x "\$3" ]]; then
	        printf "Invalid executable\n"
	        exit 1
	      fi
	      readonly executable="\$(realpath --no-symlinks "\$3")"
	      readonly args="\${*:4}"
	      if [[ -z "\${args}" ]]; then
	          applications["\$2"]="\${executable/#\${HOME}/\~}"
	      else
	          applications["\$2"]="\${executable/#\${HOME}/\~} \${*:4}"
	      fi
	      print_applications > "\${file}"
	      ;;
	    -r | --remove)
	      if [[ -z "\${applications["\$2"]+application}" ]]; then
	        printf "Unknown application\n"
	        exit 1
	      fi
	      unset applications["\$2"]
	      print_applications > "\${file}"
	      ;;
	    -l | --list)
	      print_applications | column --table --separator "="
	      ;;
	    *)
	      printf "Usage: %s [--add|--remove|--list] [APPLICATION] [EXECUTABLE] [ARGUMENTS...]\n" "\$(basename \${BASH_SOURCE[0]})"
	      exit 1
	      ;;
	  esac
	else
	  if [[ -n "\${WAYLAND_DISPLAY}" && -n "\${SWAYSOCK}" ]]; then
	    readonly selection="\$(wmenu -i -f "Source Code Pro 10" -S "${COLORS["Gray C"]}" <<< "\$(print_applications --keys)")"
	    if [[ -n "\${selection}" ]]; then
	      swaymsg "exec \${applications[\${selection}]}"
	    fi
	  else
	    printf "DISPLAY required\n"
	    exit 1
	  fi
	fi
EOF
sudo tee /usr/local/bin/screenshot <<- EOF
	#!/bin/bash

	GRIM_DEFAULT_DIR="\${HOME}"

	if [[ -n "\${WAYLAND_DISPLAY}" ]]; then
	  filename="\$(date +%Y-%m-%d-%H-%M-%S).png"

	  args=("-t" "png")
	  while [[ "\$#" -gt 0 ]]; do
	    case "\$1" in
	      -s | --select)
	        if ! geometry="\$(slurp -w 0 2> /dev/null)"; then
	          printf "No selection\n"
	          exit 1
	        fi
	        args+=("-g" "\${geometry}") || exit 1
	        shift
	        ;;
	      -c | --clipboard)
	        filename="\$(mktemp --suffix=".png")"
	        trap "{ wl-copy --type image/png < \${filename}; rm -rf \${filename}; }" EXIT
	        shift
	        ;;
	      *)
	        printf "Usage: %s [-s|--select] [-c|--clipboard]\n" "\$(basename \${BASH_SOURCE[0]})"
	        exit 1
	        ;;
	    esac
	  done
	  readonly filename args

	  grim "\${args[@]}" "\${filename}"
	fi
EOF

sudo chmod +x /usr/local/bin/application-launcher
sudo chmod +x /usr/local/bin/screenshot

sudo mkdir --parents /usr/local/share/bash-completion/completions/
sudo tee /usr/local/share/bash-completion/completions/application-launcher <<-EOF
	_application-launcher() {
	  if [[ "\${COMP_CWORD}" -eq 1 ]]; then
	    for option in \$(compgen -W "--add --remove --list" -- "\${COMP_WORDS["\${COMP_CWORD}"]}"); do
	      COMPREPLY+=("\${option} ")
	    done
	  else
	    if [[ "\${COMP_WORDS[1]}" == "--add" ]]; then
	      if [[ "\${COMP_CWORD}" -eq 2 ]]; then
	        if [[ -n "\${COMP_WORDS[2]}" ]]; then
	          COMPREPLY=("\${COMP_WORDS[2]} ")
	        fi
	      elif [[ "\${COMP_CWORD}" -eq 3 ]]; then
	        for file in \$(compgen -f -- "\${COMP_WORDS["\${COMP_CWORD}"]}"); do
	          if [[ -d "\${file}" ]]; then
	            COMPREPLY+=("\${file}/")
	          elif [[ -x "\${file}" ]]; then
	            COMPREPLY+=("\${file} ")
	          fi
	        done
	      else
	        if [[ -n "\${COMP_WORDS["\${COMP_CWORD}"]}" ]]; then
	          COMPREPLY=("\${COMP_WORDS["\${COMP_CWORD}"]} ")
	        fi
	      fi
	    elif [[ "\${COMP_WORDS[1]}" == "--remove" ]]; then
	      if [[ "\${COMP_CWORD}" -eq 2 ]]; then
	        for application in \$(compgen -W "\$(application-launcher --list | awk '{ print \$1 }')" -- "\${COMP_WORDS["\${COMP_CWORD}"]}"); do
	          COMPREPLY+=("\${application} ")
	        done
	      fi
	    fi
	  fi
	}
	complete -o nospace -F _application-launcher application-launcher
EOF
sudo tee /usr/local/share/bash-completion/completions/screenshot <<- EOF
	_screenshot() {
	  readarray -t COMPREPLY < <(compgen -W "--clipboard --select" -- "\${COMP_WORDS["\${COMP_CWORD}"]}")
	}
	complete -F _screenshot screenshot
EOF

