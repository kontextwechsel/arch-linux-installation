packages+=(
  adobe-source-code-pro-fonts
  adobe-source-sans-pro-fonts
  adobe-source-serif-pro-fonts
  noto-fonts
  noto-fonts-emoji
  ttf-liberation
)
packages+=(
  bc
  bind
  curl
  dconf
  dmidecode
  fwupd
  git
  hexedit
  htop
  jq
  lsof
  nmap
  openssl
  p7zip
