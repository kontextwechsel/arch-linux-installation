	set \$lock waylock -fork-on-lock -init-color 0x${COLORS["Gray C"]:1} -input-color 0x${COLORS["Green"]:1} -fail-color 0x${COLORS["Pink"]:1}
	set \$off swaymsg "output * power off"
	set \$on swaymsg "output * power on"
	exec swayidle -w timeout 300 '\$lock' timeout 315 '\$off' resume '\$on' lock '\$lock' before-sleep '\$lock'
	bindsym \$mod+l exec loginctl lock-session

	exec dunst
	bindsym \$mod+j exec dunstctl history-pop

	bindsym Print exec screenshot
	bindsym Shift+Print exec screenshot --select --clipboard

	include ~/.config/sway/config.d/*
EOF
