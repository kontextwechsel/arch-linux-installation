  tcpdump
  testdisk
  unrar
  unzip
  usbutils
  wget
  zip
)
readonly packages

sudo pacman --noconfirm --sync --refresh "${packages[@]}"

if [[ "${selection_install_nvidia_driver}" == "true" ]]; then
  sudo pacman --noconfirm --sync nvidia-open

  lines=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ^MODULES= ]]; then
      IFS=" " read -r -a modules <<< "$(sed -r "s/\((.*)\)/\1/g" <<< "${line#*=}")"
      modules+=(
        nvidia
        nvidia_modeset
        nvidia_uvm
        nvidia_drm
      )
      lines+=("MODULES=(${modules[*]})")
    else
      lines+=("${line}")
    fi
  done < /etc/mkinitcpio.conf
  printf "%s\n" "${lines[@]}" | sudo tee /etc/mkinitcpio.conf

  sudo mkinitcpio --preset linux
fi

sudo mkdir --parents /usr/local/bin/
sudo tee /usr/local/bin/application-launcher <<- EOF
	#!/bin/bash

	readonly file="\${HOME}/.config/application-launcher/config"

	declare -A applications
	if [[ -f "\${file}" ]]; then
	  while IFS="=" read -r application executable; do
	    applications["\${application}"]="\${executable}"
	  done < "\${file}"
	fi

	print_applications() {
	  case "\$1" in
	    -k | --keys)
	      printf "%s\n" "\${!applications[@]}" | sort
	      ;;
	    *)
	      for application in "\${!applications[@]}"; do
	        printf "%s=%s\n" "\${application}" "\${applications[\${application}]}"
	      done | sort
	      ;;
	  esac
	}

	if [[ "\$#" -gt 0 ]]; then
	  case "\$1" in
	    -a | --add)
	      if [[ ! "\$2" =~ ^[a-z0-9\ ._-]+\$ ]]; then
	        printf "Invalid application\n"
	        exit 1
	      fi
	      if [[ ! -f "\$3" || ! -x "\$3" ]]; then
	        printf "Invalid executable\n"
	        exit 1
	      fi
	      readonly executable="\$(realpath --no-symlinks "\$3")"
	      readonly args="\${*:4}"
	      if [[ -z "\${args}" ]]; then
	          applications["\$2"]="\${executable/#\${HOME}/\~}"
	      else
	          applications["\$2"]="\${executable/#\${HOME}/\~} \${*:4}"
	      fi
	      print_applications > "\${file}"
	      ;;
	    -r | --remove)
	      if [[ -z "\${applications["\$2"]+application}" ]]; then
	        printf "Unknown application\n"
	        exit 1
	      fi
	      unset applications["\$2"]
	      print_applications > "\${file}"
	      ;;
	    -l | --list)
	      print_applications | column --table --separator "="
	      ;;
	    *)
	      printf "Usage: %s [--add|--remove|--list] [APPLICATION] [EXECUTABLE] [ARGUMENTS...]\n" "\$(basename \${BASH_SOURCE[0]})"
	      exit 1
	      ;;
	  esac
	else
	  if [[ -n "\${WAYLAND_DISPLAY}" && -n "\${SWAYSOCK}" ]]; then
	    readonly selection="\$(wmenu -i -f "Source Code Pro 10" -S "${COLORS["Gray C"]}" <<< "\$(print_applications --keys)")"
	    if [[ -n "\${selection}" ]]; then
	      swaymsg "exec \${applications[\${selection}]}"
	    fi
	  else
	    printf "DISPLAY required\n"
	    exit 1
	  fi
	fi
EOF
sudo tee /usr/local/bin/screenshot <<- EOF
	#!/bin/bash

	GRIM_DEFAULT_DIR="\${HOME}"

	if [[ -n "\${WAYLAND_DISPLAY}" ]]; then
	  filename="\$(date +%Y-%m-%d-%H-%M-%S).png"

	  args=("-t" "png")
	  while [[ "\$#" -gt 0 ]]; do
	    case "\$1" in
	      -s | --select)
	        if ! geometry="\$(slurp -w 0 2> /dev/null)"; then
	          printf "No selection\n"
	          exit 1
	        fi
	        args+=("-g" "\${geometry}") || exit 1
	        shift
	        ;;
	      -c | --clipboard)
	        filename="\$(mktemp --suffix=".png")"
	        trap "{ wl-copy --type image/png < \${filename}; rm -rf \${filename}; }" EXIT
	        shift
	        ;;
	      *)
	        printf "Usage: %s [-s|--select] [-c|--clipboard]\n" "\$(basename \${BASH_SOURCE[0]})"
	        exit 1
	        ;;
	    esac
	  done
	  readonly filename args

	  grim "\${args[@]}" "\${filename}"
	fi
EOF

